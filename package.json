{
  "name": "auto-collapse-explorer",
  "displayName": "Auto-Collapse Explorer",
  "description": "Auto-collapse explorer directories that are not currently in view.",
  "version": "1.1.0",
  "license": "MIT",
  "publisher": "lukegeneva",
  "engines": {
    "vscode": "^1.68.1",
    "node": ">=24"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "autoCollapseExplorer.sentinel",
          "name": "Auto-Collapse Explorer",
          "visibility": "visible"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LukeGeneva/vscode-auto-collapse-explorer.git"
  },
  "scripts": {
    "deploy": "vsce publish",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.68.1",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^8.57.1",
    "mocha": "^11.7.1",
    "typescript": "^5.9.2"
  }
}
